# --- App URL (required for email confirmation / password reset links) ---
# The base URL Supabase should redirect back to after a signup confirmation
# or password-reset email link is clicked. http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ----------------------------------------------
# Create a project at https://supabase.com, then run the SQL files in
# supabase/migrations/ against it (see README "Database setup").
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: Settings -> API -> service_role. NEVER expose this to
# the client or commit it — it bypasses row-level security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OCR provider --------------------------------------------------------
# "mock" (default) needs no credentials and is safe for local development —
# see src/lib/services/ocr/mockOcrProvider.ts. Vendor is undecided for
# production; when you pick one, implement OcrProvider and add its case to
# getOcrProvider() in src/lib/services/ocr/ocrService.ts.
OCR_PROVIDER=mock
# GOOGLE_DOCUMENT_AI_PROJECT_ID=
# GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AZURE_FORM_RECOGNIZER_ENDPOINT=
# AZURE_FORM_RECOGNIZER_KEY=

# --- Extraction (LLM) provider ------------------------------------------
# Same pattern as OCR_PROVIDER — "mock" needs no key. See
# src/lib/services/extraction/extractionService.ts.
EXTRACTION_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Billing (Phase 2 — not called by any code yet) ----------------------
# Plans/limits are enforced from the `organizations` table already
# (see supabase/migrations/0001_init_schema.sql). Razorpay keys go here
# once payment collection is wired up behind a provider interface.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
